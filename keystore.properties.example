# Copy to keystore.properties (git-ignored) to sign release builds.
# Create the key once:  keytool -genkeypair -v -keystore ~/keys/stockanchor-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Back up the .jks and passwords somewhere safe: without them you can't update the app on Play.
storeFile=/home/you/keys/stockanchor-upload.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
